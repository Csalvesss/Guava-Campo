rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function tenant() {
      return signedIn() ? request.auth.token.sindicatoId : null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ["super_admin", "admin_sindicato", "mobilizador", "instrutor"];
    }

    match /sindicatos/{sindicatoId}/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && (request.auth.token.role == "super_admin" || tenant() == sindicatoId);
    }

    match /comprovantes/{sindicatoId}/{alunoId}/{fileName} {
      allow read: if isStaff() && (request.auth.token.role == "super_admin" || tenant() == sindicatoId);
      allow write: if signedIn() && tenant() == sindicatoId;
    }

    match /certificados/{sindicatoId}/{fileName} {
      allow read: if true;
      allow write: if isStaff() && (request.auth.token.role == "super_admin" || tenant() == sindicatoId);
    }
  }
}
